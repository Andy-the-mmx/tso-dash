{
  "pages": {
    "/[locale]/(protected)/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/[locale]/(protected)/page.js"
    ],
    "/[locale]/(protected)/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/[locale]/(protected)/layout.js"
    ],
    "/[locale]/(protected)/template": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/[locale]/(protected)/template.js"
    ],
    "/[locale]/(protected)/error": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/[locale]/(protected)/error.js"
    ],
    "/[locale]/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/[locale]/layout.css",
      "static/chunks/app/[locale]/layout.js"
    ],
    "/[locale]/error": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/[locale]/error.js"
    ],
    "/[locale]/not-found": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/[locale]/not-found.js"
    ],
    "/[locale]/[...not-found]/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/[locale]/[...not-found]/page.js"
    ]
  }
}